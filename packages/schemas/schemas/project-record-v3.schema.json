{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-agent.platform/schemas/project-record-v3.schema.json",
  "title": "ProjectRecord v3",
  "description": "V3.1 权威项目投影，包含阶段事实和带来源的验证/接受记录；V3.0 格式保持独立注册。",
  "type": "object",
  "required": [
    "version",
    "projectId",
    "revision",
    "title",
    "brief",
    "state",
    "planRevision",
    "coordinator",
    "tasks",
    "createdAt",
    "updatedAt",
    "autonomy"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "const": 3
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,80}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "object",
      "required": [
        "goal",
        "criteria"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "required",
              "origin"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^C[0-9]{1,3}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "origin": {
                "enum": [
                  "user",
                  "coordinator",
                  "legacy"
                ]
              }
            }
          }
        }
      }
    },
    "state": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "PAUSED",
        "REVIEWING",
        "COMPLETED",
        "CANCELLING",
        "CANCELLED",
        "ARCHIVED"
      ]
    },
    "planRevision": {
      "type": "integer",
      "minimum": 0
    },
    "coordinator": {
      "type": "object",
      "required": [
        "definitionRef",
        "epoch",
        "configRevision"
      ],
      "properties": {
        "definitionRef": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "configRevision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "taskId",
          "plan",
          "verifications",
          "acceptances"
        ],
        "additionalProperties": true,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "plan": {
            "type": "object"
          },
          "verifications": {
            "type": "array",
            "items": {
              "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/verification"
            }
          },
          "acceptances": {
            "type": "array",
            "items": {
              "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/acceptance"
            }
          },
          "feedbackInvalidations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "feedbackId",
                "deliveryRevision",
                "manifestHash"
              ],
              "properties": {
                "deliveryRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "manifestHash": {
                  "type": "string",
                  "minLength": 1
                },
                "feedbackId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "runtimeSwitches": {
            "type": "array",
            "items": {
              "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/runtimeSwitch"
            }
          }
        }
      }
    },
    "legacy": {
      "type": "object",
      "required": [
        "legacyProjectId"
      ],
      "properties": {
        "legacyProjectId": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "autonomy": {
      "type": "object",
      "required": [
        "version",
        "phase",
        "cycle",
        "jobs",
        "artifacts",
        "baselines"
      ],
      "additionalProperties": true,
      "properties": {
        "version": {
          "const": 1
        },
        "phase": {
          "enum": [
            "requirements",
            "rules",
            "plan",
            "execution",
            "evaluation",
            "delivery"
          ]
        },
        "cycle": {
          "type": "integer",
          "minimum": 1
        },
        "jobs": {
          "type": "array"
        },
        "artifacts": {
          "type": "array"
        },
        "baselines": {
          "type": "object"
        },
        "evaluationJobs": {
          "type": "array",
          "items": {
            "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/taskEvaluationJob"
          }
        },
        "projectEvaluationJobs": {
          "type": "array",
          "items": {
            "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/projectEvaluationJob"
          }
        },
        "projectHumanJudgements": {
          "type": "array",
          "items": {
            "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/projectHumanJudgement"
          }
        },
        "repairBudget": {
          "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/repairBudget"
        },
        "replans": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobId",
              "plannerJobId",
              "operationKey",
              "planHash",
              "reportHash",
              "createdAt"
            ],
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1
              },
              "plannerJobId": {
                "type": "string",
                "minLength": 1
              },
              "operationKey": {
                "type": "string",
                "minLength": 1
              },
              "planHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reportHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "feedbacks": {
          "type": "array",
          "items": {
            "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/projectFeedback"
          }
        },
        "planRevisionRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestId",
              "messageId",
              "text",
              "userId",
              "plannerJobId",
              "planHash",
              "operationKey",
              "createdAt"
            ],
            "properties": {
              "requestId": {
                "type": "string",
                "minLength": 1
              },
              "messageId": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "userId": {
                "type": "string",
                "minLength": 1
              },
              "plannerJobId": {
                "type": "string",
                "minLength": 1
              },
              "planHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "operationKey": {
                "type": "string",
                "minLength": 1
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "deliveryId",
        "decision",
        "at",
        "signer",
        "criteriaJudgments"
      ],
      "additionalProperties": false,
      "properties": {
        "deliveryId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "ACCEPT",
            "REWORK"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "signer": {
          "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/userSigner"
        },
        "criteriaJudgments": {
          "type": "array"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deliveryId",
          "revision",
          "projectRevision",
          "planRevision",
          "tasks",
          "coverage",
          "limitations",
          "proposedAt"
        ],
        "properties": {
          "deliveryId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "projectRevision": {
            "type": "integer",
            "minimum": 1
          },
          "planRevision": {
            "type": "integer",
            "minimum": 1
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taskId",
                "required",
                "acceptanceId",
                "deliveryRevision",
                "manifestHash"
              ],
              "properties": {
                "taskId": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "acceptanceId": {
                  "type": "string",
                  "minLength": 1
                },
                "deliveryRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "manifestHash": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId",
                "required",
                "taskIds",
                "machine"
              ],
              "properties": {
                "criterionId": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "taskIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "machine": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proposedAt": {
            "type": "string",
            "format": "date-time"
          },
          "overallEvaluation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobId",
              "candidateHash",
              "reportHash"
            ],
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1
              },
              "candidateHash": {
                "type": "string",
                "minLength": 1
              },
              "reportHash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "budget": {
          "$ref": "https://pi-agent.platform/schemas/project-event-v2.schema.json#/$defs/executionBudget"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "acceptance"
        ],
        "properties": {
          "acceptance": {
            "type": "object",
            "required": [
              "decision"
            ],
            "properties": {
              "decision": {
                "const": "ACCEPT"
              }
            }
          }
        }
      }
    }
  ]
}
