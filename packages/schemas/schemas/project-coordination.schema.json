{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-agent.platform/schemas/project-coordination.schema.json",
  "title": "project-coordination@1",
  "description": "V3.0 §5.2 / §15.1：项目主 Agent 的结构化建议。只是提议：宿主核对项目/计划版本、epoch、目标任务与授权后才可能准备操作；动作枚举固定。",
  "type": "object",
  "required": [
    "version",
    "projectId",
    "projectRevision",
    "planRevision",
    "coordinatorEpoch",
    "basisEventRefs",
    "summary",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "project-coordination@1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,80}$"
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 0
    },
    "planRevision": {
      "type": "integer",
      "minimum": 0
    },
    "coordinatorEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "basisEventRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 40
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "actions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "actionId",
          "type",
          "expectedEffect",
          "authorizationRequired",
          "uncertainty"
        ],
        "additionalProperties": false,
        "properties": {
          "actionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "type": {
            "enum": [
              "clarify",
              "propose-plan",
              "revise-plan",
              "prepare-task-draft",
              "request-contract-confirmation",
              "request-start-confirmation",
              "propose-handoff",
              "suggest-retry",
              "summarize-progress",
              "request-project-acceptance",
              "delegate-stage",
              "continue-stage",
              "repair-task",
              "replan",
              "classify-feedback",
              "reassess-feedback-work"
            ]
          },
          "targetTaskId": {
            "type": "string",
            "pattern": "^t-[a-z0-9-]{1,40}$"
          },
          "inputRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          },
          "expectedEffect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "authorizationRequired": {
            "enum": [
              "none",
              "user-plan-approval",
              "user-contract-confirmation",
              "user-start-confirmation",
              "user-acceptance",
              "user-decision"
            ]
          },
          "uncertainty": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 10
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "maxItems": 10
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "maxItems": 10
          },
          "plan": {
            "$ref": "#/$defs/planProposal"
          },
          "draft": {
            "type": "object",
            "required": [
              "instructions"
            ],
            "additionalProperties": false,
            "properties": {
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "maxItems": 20
              }
            }
          },
          "stage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "role"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "requirements",
                  "rules",
                  "plan"
                ]
              },
              "role": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "definitionRef",
                  "runtimeKind"
                ],
                "properties": {
                  "definitionRef": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,62}@[0-9]+\\.[0-9]+\\.[0-9]+$"
                  },
                  "runtimeKind": {
                    "enum": [
                      "codex",
                      "claude-code",
                      "pi"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effort": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "stageContinuation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobId",
              "feedback"
            ],
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 100
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            }
          },
          "repair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobId",
              "criterionIds"
            ],
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1
              },
              "criterionIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "replan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobId",
              "plannerJobId"
            ],
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1
              },
              "plannerJobId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "feedbackClassification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feedbackId",
              "requirementsChanged",
              "rulesChanged",
              "uncertain",
              "rationale",
              "impacts"
            ],
            "properties": {
              "feedbackId": {
                "type": "string",
                "minLength": 1
              },
              "requirementsChanged": {
                "type": "boolean"
              },
              "rulesChanged": {
                "type": "boolean"
              },
              "uncertain": {
                "type": "boolean"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "impacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "taskId",
                    "snapshotHash",
                    "disposition",
                    "reason"
                  ],
                  "properties": {
                    "taskId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "snapshotHash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "disposition": {
                      "enum": [
                        "reuse",
                        "recheck",
                        "rework",
                        "unneeded",
                        "insufficient"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "delegate-stage"
                }
              }
            },
            "then": {
              "required": [
                "stage"
              ],
              "properties": {
                "authorizationRequired": {
                  "const": "none"
                },
                "stage": {}
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "continue-stage"
                }
              }
            },
            "then": {
              "required": [
                "stageContinuation"
              ],
              "properties": {
                "stageContinuation": {},
                "authorizationRequired": {
                  "const": "none"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "repair-task"
                }
              }
            },
            "then": {
              "required": [
                "repair"
              ],
              "properties": {
                "authorizationRequired": {
                  "const": "none"
                },
                "repair": {}
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "replan"
                }
              }
            },
            "then": {
              "required": [
                "replan"
              ],
              "properties": {
                "replan": {},
                "authorizationRequired": {
                  "const": "none"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "classify-feedback"
                }
              }
            },
            "then": {
              "required": [
                "feedbackClassification"
              ],
              "properties": {
                "authorizationRequired": {
                  "const": "none"
                },
                "feedbackClassification": {}
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "reassess-feedback-work"
                }
              }
            },
            "then": {
              "required": [
                "feedbackClassification"
              ],
              "properties": {
                "authorizationRequired": {
                  "const": "none"
                },
                "feedbackClassification": {}
              }
            }
          }
        ]
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "classification",
        "confidence",
        "requiresRevision"
      ],
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "goal-supplement",
            "task-feedback",
            "progress-query",
            "resource-change",
            "pause-cancel"
          ]
        },
        "targetTaskId": {
          "type": "string",
          "pattern": "^t-[a-z0-9-]{1,40}$"
        },
        "confidence": {
          "enum": [
            "unique",
            "ambiguous",
            "none"
          ]
        },
        "answer": {
          "type": "string",
          "maxLength": 4000
        },
        "forwardText": {
          "type": "string",
          "maxLength": 8000
        },
        "requiresRevision": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "planProposal": {
      "type": "object",
      "required": [
        "tasks",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "taskId",
              "title",
              "purpose",
              "required",
              "definitionRef",
              "runtimeKind",
              "coversCriteria",
              "dependsOn",
              "outputs",
              "acceptance"
            ],
            "additionalProperties": false,
            "properties": {
              "taskId": {
                "type": "string",
                "pattern": "^t-[a-z0-9-]{1,40}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "required": {
                "type": "boolean"
              },
              "definitionRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,62}@[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "runtimeKind": {
                "enum": [
                  "codex",
                  "claude-code",
                  "pi"
                ]
              },
              "coversCriteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^C[0-9]{1,3}$"
                },
                "maxItems": 20
              },
              "dependsOn": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": [
                    "taskId",
                    "artifact",
                    "purpose"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "taskId": {
                      "type": "string",
                      "pattern": "^t-[a-z0-9-]{1,40}$"
                    },
                    "artifact": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "mediaType",
                    "required"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,159}$"
                    },
                    "mediaType": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 100
                    },
                    "schemaRef": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*@[0-9]+$"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "parallelReason": {
                "type": "string",
                "maxLength": 500
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "effort": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        }
      }
    }
  }
}
