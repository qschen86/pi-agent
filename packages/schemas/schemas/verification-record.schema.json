{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-agent.platform/schemas/verification-record.schema.json",
  "title": "VerificationRecord",
  "description": "AP-QA-008 §3：条件级验证结论与证据。必须绑定 artifact hash 与 plan hash。",
  "type": "object",
  "required": ["recordId", "criterionId", "result", "evaluator", "artifactHash", "evidenceRefs", "provenance"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "recordId": { "type": "string", "pattern": "^vr_[a-f0-9]{16,64}$" },
    "criterionId": { "type": "string", "pattern": "^AC-?[0-9]{1,4}$" },
    "result": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "evaluator": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["rule", "test", "human", "llm-judge", "composite"] },
        "ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "artifactHash": { "$ref": "#/$defs/sha256" },
    "measurements": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^evidence://.+$" }
    },
    "provenance": {
      "type": "object",
      "required": ["planHash", "executedBy"],
      "additionalProperties": false,
      "properties": {
        "planHash": { "$ref": "#/$defs/sha256" },
        "executedBy": { "type": "string", "minLength": 1 },
        "executedAt": { "type": "string", "format": "date-time" },
        "environment": { "type": "string" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
