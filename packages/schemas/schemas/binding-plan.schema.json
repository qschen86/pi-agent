{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-agent.platform/schemas/binding-plan.schema.json",
  "title": "BindingPlan",
  "description": "AP-COMP-003 §4：编译后的不可变执行计划，内容寻址（planHash = SHA256(JCS(plan without signature))）。",
  "type": "object",
  "required": [
    "planId",
    "planHash",
    "compilerVersion",
    "pins",
    "effectivePolicy",
    "contextPlan",
    "runtimeBindings",
    "verificationGraph",
    "signature",
    "sourceDigests"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^bp_[a-f0-9]{16}$"
    },
    "planHash": {
      "$ref": "#/$defs/sha256"
    },
    "compilerVersion": {
      "type": "string",
      "minLength": 1
    },
    "pins": {
      "type": "object",
      "required": [
        "agent",
        "contract",
        "registrySnapshotId",
        "capabilityCatalogVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "contract": {
          "type": "integer",
          "minimum": 1
        },
        "workflow": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "registrySnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityCatalogVersion": {
          "type": "string",
          "minLength": 1
        },
        "orgPolicyVersion": {
          "type": "string",
          "minLength": 1
        },
        "modelCatalogVersion": {
          "description": "v2.4：合约选定执行模型时，判定依据的平台模型目录版本",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "effectivePolicy": {
      "type": "object",
      "required": [
        "filesystem",
        "network",
        "tools",
        "approvals",
        "deny",
        "commands"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "filesystem": {
          "type": "object",
          "required": [
            "read",
            "write"
          ],
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/posixPath"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/posixPath"
              }
            },
            "maxWriteBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "network": {
          "type": "object",
          "required": [
            "default",
            "allow"
          ],
          "additionalProperties": false,
          "properties": {
            "default": {
              "enum": [
                "deny",
                "allow"
              ]
            },
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tools": {
          "type": "object",
          "required": [
            "allow"
          ],
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "approvals": {
          "type": "object",
          "required": [
            "sideEffects"
          ],
          "additionalProperties": false,
          "properties": {
            "sideEffects": {
              "enum": [
                "AUTO",
                "REVIEW",
                "DUAL"
              ]
            }
          }
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "deny": {
          "type": "array",
          "description": "并集后的禁止项；deny 优先，不可被覆盖",
          "items": {
            "type": "object",
            "required": [
              "resource",
              "pattern"
            ],
            "additionalProperties": false,
            "properties": {
              "resource": {
                "enum": [
                  "filesystem",
                  "network",
                  "command",
                  "credential",
                  "tool",
                  "budget"
                ]
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "degradations": {
          "type": "array",
          "description": "显式降级记录（仅在 allowExplicitDegrade 时出现）",
          "items": {
            "type": "object",
            "required": [
              "reason",
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "commands": {
          "type": "object",
          "description": "受控命令执行：逐层取交集后的可执行文件白名单；空数组 = 不可执行任何命令",
          "additionalProperties": false,
          "required": [
            "allow"
          ],
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "webResearch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceDomains"
          ],
          "description": "联网检索的来源范围（v1.8）：允许阅读哪些网页域名。\"*\" 表示开放来源，需显式声明；未声明即不授予。",
          "properties": {
            "sourceDomains": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(\\*|([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63})$"
              }
            }
          }
        }
      }
    },
    "contextPlan": {
      "type": "object",
      "required": [
        "layers",
        "budgetTokens",
        "truncation"
      ],
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "budgetTokens"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "identity",
                  "principles",
                  "knowledge",
                  "task",
                  "history",
                  "toolOutput"
                ]
              },
              "budgetTokens": {
                "type": "integer",
                "minimum": 0
              },
              "truncate": {
                "enum": [
                  "head",
                  "tail",
                  "summarize"
                ],
                "default": "tail"
              }
            }
          }
        },
        "budgetTokens": {
          "type": "integer",
          "minimum": 1
        },
        "truncation": {
          "enum": [
            "head",
            "tail",
            "summarize"
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mission",
            "principles"
          ],
          "properties": {
            "mission": {
              "type": "string",
              "minLength": 1
            },
            "principles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["ref", "description", "instructions"],
            "additionalProperties": false,
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "instructions": { "type": "string", "minLength": 1 }
            }
          }
        },
        "task": {
          "type": "object",
          "description": "任务上下文：本次要做什么、怎样才算完成（UC-004/005/019 随计划进入 Runtime）",
          "additionalProperties": false,
          "required": [
            "taskId",
            "goal",
            "requirements",
            "assumptions",
            "deliverables",
            "acceptanceCriteria"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "goal": {
              "type": "string"
            },
            "requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "用户原话（USER_REQUIREMENT）"
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Agent 推断（ASSUMPTION），与用户需求分列"
            },
            "deliverables": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "mediaType"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mediaType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "renderedFrom": {
                    "type": "string",
                    "minLength": 1,
                    "description": "由平台从该源交付物确定性渲染，执行方不必编写"
                  }
                }
              }
            },
            "acceptanceCriteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "statement",
                  "expected",
                  "required"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statement": {
                    "type": "string"
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            },
            "research": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "brief",
                "briefHash"
              ],
              "description": "调研类合约（v2.1）：用户确认的调研需求与哈希",
              "properties": {
                "brief": {
                  "type": "object"
                },
                "briefHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "presentation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["brief", "briefHash", "inputs"],
              "description": "PPT 子任务（v2.6）：冻结的 PPT 需求与哈希；宿主放进 /workspace/in 的只读输入（报告快照等，带内容哈希）",
              "properties": {
                "brief": { "type": "object" },
                "briefHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "name"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "name": { "type": "string", "minLength": 1 },
                      "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "mediaType": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "runtimeBindings": {
      "type": "object",
      "required": [
        "cognitive"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "cognitive": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinking": {
              "description": "v2.4：执行模型钉住的推理强度（启动 Pi 时显式传入）",
              "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
            }
          }
        }
      }
    },
    "verificationGraph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterionId",
          "evaluator",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "criterionId": {
            "type": "string",
            "pattern": "^AC-?[0-9]{1,4}$"
          },
          "evaluator": {
            "type": "string",
            "minLength": 1
          },
          "evaluatorVersion": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-?[0-9]{1,4}$"
            }
          }
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/sha256"
    },
    "sourceDigests": {
      "type": "object",
      "required": [
        "agent",
        "contract"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/sha256"
        },
        "contract": {
          "$ref": "#/$defs/sha256"
        },
        "workflow": {
          "$ref": "#/$defs/sha256"
        },
        "orgPolicy": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "posixPath": {
      "type": "string",
      "pattern": "^/[^\u0000-\u001f]*$",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
